cmake_minimum_required(VERSION 3.16)

if(NOT DEFINED CASE)
    file(REMOVE_RECURSE "${TEST_DIR}")
    file(MAKE_DIRECTORY "${TEST_DIR}")
    set(cases positive hash count duplicate-classification missing-classification
        unexercised duplicate-case listed-as-run invalid-index wrong-case-count
        body-pairs body-line listed-as-body listed-as-complete)
    foreach(case IN LISTS cases)
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASE=${case}"
            "-DTEST_DIR=${TEST_DIR}/${case}" -P "${CMAKE_CURRENT_LIST_FILE}"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 5)
        file(WRITE "${TEST_DIR}/${case}.log" "${output}${errors}")
        if(case STREQUAL "positive")
            if(NOT status EQUAL 0 OR NOT errors STREQUAL "")
                message(FATAL_ERROR "Native manifest positive failed:\n${output}${errors}")
            endif()
        else()
            set(expected_hash "inventory needs review")
            set(expected_count "fence count changed")
            set(expected_duplicate-classification "duplicate native classification")
            set(expected_missing-classification "missing classification")
            set(expected_unexercised "native classification has no case")
            set(expected_duplicate-case "Invalid/duplicate native case")
            set(expected_listed-as-run "is not classified run")
            set(expected_invalid-index "invalid native fence")
            set(expected_wrong-case-count "programs count changed")
            set(expected_body-pairs "expected diagnostic message/line pairs")
            set(expected_body-line "invalid original fence line")
            set(expected_listed-as-body "is not classified run")
            set(expected_listed-as-complete "is not classified reject")
            if(NOT status EQUAL 1 OR NOT errors MATCHES "${expected_${case}}")
                message(FATAL_ERROR "${case}: wrong native manifest failure (${status}):\n${output}${errors}")
            endif()
        endif()
    endforeach()
    message(STATUS "Native manifest: one positive and thirteen independent negative guards")
    return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/doc_native.cmake")
set(ROOT "${TEST_DIR}/root")
set(TEST_DIR "${TEST_DIR}/out")
file(MAKE_DIRECTORY "${ROOT}/docs")
# The source contains semicolons, braces, comments and CRLF. It must survive
# the reader and observer/diagnostic writers byte-for-byte, without a compiler.
set(code "value() { \"semi; brace { }\" }\r\n// keep café π\r\n")
set(body "let text = \"semi; brace { }\"\r\n// café π\r\n")
set(rejected "let n: int = true\r\nlet b: bool = 1\r\n")
set(complete "main() {\r\n  break\r\n}\r\n")
set(document "header\n\n```\n${code}```\n\n```\nbroken() -> str { 1 }\n```\n\n```\nmissing.api()\n```\n\n```\n${body}```\n\n```\n${rejected}```\n\n```\n${complete}```\n")
file(WRITE "${ROOT}/docs/lang-fixture.txt" "${document}")
file(SHA256 "${ROOT}/docs/lang-fixture.txt" hash)
set(count 6)
if(CASE STREQUAL "hash")
    set(hash "stale-hash")
elseif(CASE STREQUAL "count")
    set(count 7)
endif()
native_begin(lang-fixture "${count}" "${hash}")
if(CASE STREQUAL "duplicate-classification")
    native_fences(context "no APIs" "1")
    native_fences(run "duplicate" "1")
elseif(CASE STREQUAL "missing-classification")
    native_fences(context "only five classified" "1;2;3;4;5")
    native_finish(0 0 5 0)
elseif(CASE STREQUAL "unexercised")
    native_fences(run "no case" "1")
    native_fences(context "no APIs" "2;3;4;5;6")
    native_finish(0 0 5 0)
elseif(CASE STREQUAL "invalid-index")
    native_fences(context "invalid" "7")
elseif(CASE STREQUAL "listed-as-run")
    native_fences(context "no APIs" "1")
    native_run(1 forbidden "" "")
elseif(CASE STREQUAL "listed-as-body")
    native_fences(context "no APIs" "4")
    native_run_body(4 forbidden "" "")
elseif(CASE STREQUAL "listed-as-complete")
    native_fences(context "no APIs" "6")
    native_reject_complete(6 forbidden "not an accepted case" 1)
elseif(CASE MATCHES "^body-(pairs|line)$")
    native_fences(reject "whole rejected body" "5")
    if(CASE STREQUAL "body-pairs")
        native_reject_body(5 bad "missing line")
    else()
        native_reject_body(5 bad "bad line" 0)
    endif()
else()
    native_fences(run "whole fence" "1;4")
    native_fences(reject "whole rejected fence" "2;5;6")
    native_fences(context "do not invent missing APIs" "3")
    native_run(1 observer "print(value())" "// expect: semi; brace { }")
    if(CASE STREQUAL "duplicate-case")
        native_run(1 observer "print(value())" "")
    endif()
    native_run_body(4 body-observer "print(text)" "// expect: semi; brace { }")
    native_reject(2 diagnostic "Function body does not match the written return type." 1)
    native_reject_body(5 body-diagnostic "first; diagnostic" 1 "second diagnostic" 2)
    native_reject_complete(6 complete-diagnostic "loop error" 2)
    native_prose(independent "main() {}\n")
    if(CASE STREQUAL "wrong-case-count")
        native_finish(4 3 1 1)
    else()
        native_finish(3 3 1 1)
        read_doc_bytes("${TEST_DIR}/programs/observer.brf" actual)
        if(NOT actual STREQUAL "${code}\nmain() {\nprint(value())\n}\n// expect: semi; brace { }\n")
            message(FATAL_ERROR "Whole source/observer bytes changed")
        endif()
        read_doc_bytes("${TEST_DIR}/diagnostics/diagnostic.brf" actual)
        if(NOT actual STREQUAL "broken() -> str { 1 }\n\nmain() {}\n")
            message(FATAL_ERROR "Rejected fence bytes changed")
        endif()
        read_doc_bytes("${TEST_DIR}/programs/body-observer.brf" actual)
        if(NOT actual STREQUAL "main() {\n${body}\nprint(text)\n}\n// expect: semi; brace { }\n")
            message(FATAL_ERROR "Body source/observer bytes changed")
        endif()
        read_doc_bytes("${TEST_DIR}/diagnostics/body-diagnostic.brf" actual)
        if(NOT actual STREQUAL "main() {\n${rejected}\n}\n")
            message(FATAL_ERROR "Rejected body bytes changed")
        endif()
        get_property(count GLOBAL PROPERTY native_body-diagnostic_count)
        get_property(first GLOBAL PROPERTY native_body-diagnostic_1_message)
        get_property(first_line GLOBAL PROPERTY native_body-diagnostic_1_line)
        get_property(second_line GLOBAL PROPERTY native_body-diagnostic_2_line)
        if(NOT count EQUAL 2 OR NOT first STREQUAL "first; diagnostic" OR
           NOT first_line EQUAL 2 OR NOT second_line EQUAL 3)
            message(FATAL_ERROR "Diagnostic message/frame metadata changed")
        endif()
        read_doc_bytes("${TEST_DIR}/diagnostics/complete-diagnostic.brf" actual)
        get_property(line GLOBAL PROPERTY native_complete-diagnostic_1_line)
        if(NOT actual STREQUAL complete OR NOT line EQUAL 2)
            message(FATAL_ERROR "Complete source changed or entry duplicated")
        endif()
        file(GLOB files "${TEST_DIR}/programs/*.brf" "${TEST_DIR}/diagnostics/*.brf")
        list(LENGTH files count)
        if(NOT count EQUAL 6)
            message(FATAL_ERROR "Listed fence generated a native case")
        endif()
    endif()
endif()
