# Complete first-version examples are read directly from the design docs.
# Expression/statement fragments are wrapped in main; bare types and pattern
# arms get their own small wrappers. Semantic-error examples must still parse.
# Standalone signatures, pseudo-code, multiple-file API notation, and blocks
# containing later-version syntax (lambdas, traits, named tuples, map literals)
# are not complete first-version programs; their in-scope grammar is covered
# separately in test_parser.c. Block counts guard the index-based manifest
# against silent drift when an example is added or removed.
file(MAKE_DIRECTORY "${TEST_DIR}")
set(case_count 0)
function(doc filename expected_count body top types arms bad_body bad_top)
    file(READ "${ROOT}/docs/${filename}.txt" rest)
    set(count 0)
    while(TRUE)
        string(FIND "${rest}" "```" opening)
        if(opening LESS 0)
            break()
        endif()
        math(EXPR opening "${opening} + 3")
        string(SUBSTRING "${rest}" ${opening} -1 rest)
        string(FIND "${rest}" "\n" newline)
        math(EXPR newline "${newline} + 1")
        string(SUBSTRING "${rest}" ${newline} -1 rest)
        string(FIND "${rest}" "```" closing)
        if(closing LESS 0)
            message(FATAL_ERROR "unclosed code fence in ${filename}")
        endif()
        math(EXPR count "${count} + 1")
        string(SUBSTRING "${rest}" 0 ${closing} block_${count})
        math(EXPR closing "${closing} + 3")
        string(SUBSTRING "${rest}" ${closing} -1 rest)
    endwhile()
    if(NOT count EQUAL expected_count)
        message(FATAL_ERROR "${filename}: code block count changed (${count}); update the parser-example manifest")
    endif()
    # Optional final indices are examples with declarations followed by usage.
    set(mixed "${ARGN}")
    foreach(mode IN ITEMS body top types arms bad_body bad_top mixed)
        foreach(index IN LISTS ${mode})
            set(code "${block_${index}}")
            if(filename STREQUAL "lang-syntax" AND index EQUAL 3)
                # Preserve every continuation example, replacing only the
                # later-version lambda call with an ordinary method call.
                set(lambda_call ".find((user) => user.getAge() > 30)")
                string(FIND "${code}" "${lambda_call}" lambda_position)
                if(lambda_position LESS 0)
                    message(FATAL_ERROR "lang-syntax block 3 changed; update its lambda adapter")
                endif()
                string(REPLACE "${lambda_call}" ".findOlderThan(30)" code "${code}")
            endif()
            if(mode STREQUAL "body" OR mode STREQUAL "bad_body")
                set(code "main() {\n${code}\n}\n")
            elseif(mode STREQUAL "mixed")
                set(usage_start "\nlet ")
                if(filename STREQUAL "lang-types" AND index EQUAL 21)
                    set(usage_start "\nnodeA == nodeB")
                endif()
                string(FIND "${code}" "${usage_start}" split)
                if(split LESS 0)
                    message(FATAL_ERROR "${filename} block ${index}: update the mixed-example wrapper")
                endif()
                string(SUBSTRING "${code}" 0 ${split} definitions)
                string(SUBSTRING "${code}" ${split} -1 usage)
                set(code "${definitions}\nmain() {\n${usage}\n}\n")
            elseif(mode STREQUAL "types")
                set(code "type Example = ${code}\n")
            elseif(mode STREQUAL "arms")
                set(code "main() { value |> {\n${code}\n} }\n")
            endif()
            set(path "${TEST_DIR}/${filename}-${index}.brf")
            file(WRITE "${path}" "${code}")
            execute_process(COMMAND "${BRIEF}" dump-ast "${path}"
                RESULT_VARIABLE status OUTPUT_VARIABLE tree ERROR_VARIABLE errors)
            if(mode MATCHES "^bad_")
                if(NOT status EQUAL 1 OR NOT tree STREQUAL "")
                    message(FATAL_ERROR "${filename} block ${index}: expected a syntax error (${status}):\n${errors}\n${tree}")
                endif()
            elseif(NOT status EQUAL 0 OR NOT errors STREQUAL "" OR NOT tree MATCHES "^\\(program")
                message(FATAL_ERROR "${filename} block ${index} (${mode}) did not parse (${status}):\n${errors}\nsource:\n${code}")
            endif()
            math(EXPR case_count "${case_count} + 1")
        endforeach()
    endforeach()
    set(case_count ${case_count} PARENT_SCOPE)
endfunction()

