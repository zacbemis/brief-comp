# Current-document native audit support. No spelling adapters or API stand-ins.
# Reuse only the current manifest's hash-checked, whole-fence reader and its
# completeness check. Parser classifications/execution are not native evidence.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/doc_parser.cmake")

function(native_begin name count hash)
    get_property(started GLOBAL PROPERTY native_started)
    if(started)
        message(FATAL_ERROR "Only one native chapter per CMake invocation")
    endif()
    set_property(GLOBAL PROPERTY native_started TRUE)
    if(NOT IS_ABSOLUTE "${TEST_DIR}" OR TEST_DIR STREQUAL ROOT OR TEST_DIR STREQUAL "/")
        message(FATAL_ERROR "Native audit needs a separate absolute TEST_DIR")
    endif()
    file(REMOVE_RECURSE "${TEST_DIR}")
    file(MAKE_DIRECTORY "${TEST_DIR}/programs" "${TEST_DIR}/diagnostics")
    file(WRITE "${TEST_DIR}/inventory.txt" "Current native audit; listed fences are NOT passing native tests.\n")
    file(WRITE "${TEST_DIR}/cases.txt" "Whole fences plus entry observers; prose programs are separate.\n")
    chapter("${name}" "${count}" "${hash}")
endfunction()

function(native_fences kind reason indices)
    get_property(chapter GLOBAL PROPERTY doc_active)
    get_property(count GLOBAL PROPERTY doc_count)
    if(NOT chapter OR reason STREQUAL "" OR NOT kind MATCHES "^(run|reject|later|context|fragment|n2)$")
        message(FATAL_ERROR "Invalid native classification: ${kind}")
    endif()
    foreach(index IN LISTS indices)
        if(NOT index MATCHES "^[1-9][0-9]*$" OR index GREATER count)
            message(FATAL_ERROR "${chapter}: invalid native fence ${index}")
        endif()
        get_property(previous GLOBAL PROPERTY doc_${chapter}_${index}_kind)
        if(previous)
            message(FATAL_ERROR "${chapter}:${index}: duplicate native classification")
        endif()
        set_property(GLOBAL PROPERTY doc_${chapter}_${index}_kind "${kind}")
        file(APPEND "${TEST_DIR}/inventory.txt" "${chapter}:${index} ${kind}: ${reason}\n")
        if(NOT kind MATCHES "^(run|reject)$")
            set_property(GLOBAL APPEND PROPERTY native_listings "${index}")
        endif()
    endforeach()
endfunction()

# A zero-fence reference chapter is one whole, unaccepted raw listing. Save
# bytes as .txt, never as a runner input; no fragments are extracted from it.
function(native_raw_listing reason)
    get_property(chapter GLOBAL PROPERTY doc_active)
    get_property(count GLOBAL PROPERTY doc_count)
    get_property(previous GLOBAL PROPERTY doc_${chapter}_0_kind)
    if(NOT chapter OR NOT count EQUAL 0 OR reason STREQUAL "")
        message(FATAL_ERROR "Raw native listing needs a zero-fence chapter and reason")
    endif()
    if(previous)
        message(FATAL_ERROR "${chapter}: duplicate raw native listing")
    endif()
    set_property(GLOBAL PROPERTY doc_${chapter}_0_kind raw)
    set_property(GLOBAL APPEND PROPERTY native_listings 0)
    read_doc_bytes("${ROOT}/docs/${chapter}.txt" source)
    file(MAKE_DIRECTORY "${TEST_DIR}/listed")
    file(WRITE "${TEST_DIR}/listed/${chapter}.txt" "${source}")
    file(APPEND "${TEST_DIR}/inventory.txt" "${chapter}:0 raw (NOT native acceptance): ${reason}\n")
endfunction()

function(native_case name index kind)
    get_property(chapter GLOBAL PROPERTY doc_active)
    get_property(names GLOBAL PROPERTY native_names)
    if(NOT chapter OR NOT name MATCHES "^[a-z][a-z0-9-]*$" OR name IN_LIST names)
        message(FATAL_ERROR "Invalid/duplicate native case: ${name}")
    endif()
    if(kind STREQUAL "prose")
        set_property(GLOBAL APPEND PROPERTY native_prose "${name}")
    elseif(kind STREQUAL "example")
        set_property(GLOBAL APPEND PROPERTY native_examples "${name}")
    else()
        get_property(classification GLOBAL PROPERTY doc_${chapter}_${index}_kind)
        if(NOT classification STREQUAL kind)
            message(FATAL_ERROR "${name}: fence ${index} is not classified ${kind}")
        endif()
        set_property(GLOBAL APPEND PROPERTY native_${index}_cases "${name}")
    endif()
    set_property(GLOBAL APPEND PROPERTY native_names "${name}")
    file(APPEND "${TEST_DIR}/cases.txt" "${name}: ${kind} ${index}\n")
endfunction()

function(native_run index name observer expectations)
    native_case("${name}" "${index}" run)
    get_property(chapter GLOBAL PROPERTY doc_active)
    get_property(code GLOBAL PROPERTY doc_${chapter}_${index}_code)
    # The entire fence is the unchanged file prefix. Only an observing entry
    # point and test expectations are appended; no missing types/APIs/bodies.
    file(WRITE "${TEST_DIR}/programs/${name}.brf" "${code}\nmain() {\n${observer}\n}\n${expectations}\n")
    set_property(GLOBAL APPEND PROPERTY native_programs "${name}")
endfunction()

# Body fences get only an enclosing entry point. Their bytes are unchanged;
# observers remain in that same scope, after the complete quoted body.
function(native_run_body index name observer expectations)
    native_case("${name}" "${index}" run)
    get_property(chapter GLOBAL PROPERTY doc_active)
    get_property(code GLOBAL PROPERTY doc_${chapter}_${index}_code)
    file(WRITE "${TEST_DIR}/programs/${name}.brf" "main() {\n${code}\n${observer}\n}\n${expectations}\n")
    set_property(GLOBAL APPEND PROPERTY native_programs "${name}")
endfunction()

# Store messages separately: a semicolon in a diagnostic is not a list split.
function(native_expect_diagnostic name message line)
    get_property(count GLOBAL PROPERTY native_${name}_count)
    if(NOT count)
        set(count 0)
    endif()
    math(EXPR count "${count} + 1")
    set_property(GLOBAL PROPERTY native_${name}_count "${count}")
    set_property(GLOBAL PROPERTY native_${name}_${count}_message "${message}")
    set_property(GLOBAL PROPERTY native_${name}_${count}_line "${line}")
endfunction()

# Optional exact same-line fix preview for a particular primary diagnostic.
# Store the whole printed source line, not a substring that could hide edits.
function(native_expect_fix name index preview)
    get_property(count GLOBAL PROPERTY native_${name}_count)
    get_property(previous GLOBAL PROPERTY native_${name}_${index}_fix SET)
    if(NOT count OR NOT index MATCHES "^[1-9][0-9]*$" OR index GREATER count)
        message(FATAL_ERROR "${name}: fix has no expected diagnostic")
    endif()
    if(previous)
        message(FATAL_ERROR "${name}: duplicate expected fix")
    endif()
    set_property(GLOBAL PROPERTY native_${name}_${index}_fix "${preview}")
endfunction()

function(native_check_fixes name index diagnostic)
    get_property(expected GLOBAL PROPERTY native_${name}_${index}_fix SET)
    string(REGEX MATCHALL "(^|\n)help:" found "${diagnostic}")
    list(LENGTH found count)
    if(expected)
        get_property(preview GLOBAL PROPERTY native_${name}_${index}_fix)
        string(REGEX MATCH "(^|\n)help:[^\n]*" actual "${diagnostic}")
        string(REGEX REPLACE "^\n" "" actual "${actual}")
        if(NOT count EQUAL 1 OR NOT actual STREQUAL "help: write `${preview}`")
            message(FATAL_ERROR "${name}: expected one exact fix preview:\n${diagnostic}")
        endif()
    elseif(count GREATER 0)
        message(FATAL_ERROR "${name}: unexpected fix preview:\n${diagnostic}")
    endif()
endfunction()

function(native_reject index name message line)
    native_case("${name}" "${index}" reject)
    get_property(chapter GLOBAL PROPERTY doc_active)
    get_property(code GLOBAL PROPERTY doc_${chapter}_${index}_code)
    # Do not insert // error markers into the quoted function. Preserve its
    # original line numbers and check the diagnostic separately from the runner.
    file(WRITE "${TEST_DIR}/diagnostics/${name}.brf" "${code}\nmain() {}\n")
    set_property(GLOBAL APPEND PROPERTY native_diagnostics "${name}")
    native_expect_diagnostic("${name}" "${message}" "${line}")
endfunction()

# A fence that already contains its entry point needs no wrapper at all.
# In particular, appending another main would mask the intended rejection.
function(native_reject_complete index name message line)
    native_case("${name}" "${index}" reject)
    get_property(chapter GLOBAL PROPERTY doc_active)
    get_property(code GLOBAL PROPERTY doc_${chapter}_${index}_code)
    file(WRITE "${TEST_DIR}/diagnostics/${name}.brf" "${code}")
    set_property(GLOBAL APPEND PROPERTY native_diagnostics "${name}")
    native_expect_diagnostic("${name}" "${message}" "${line}")
endfunction()

# Arguments after name are message/original-fence-line pairs. Only the body
# wrapper's one-line offset is applied; no error markers enter quoted code.
function(native_reject_body index name)
    native_case("${name}" "${index}" reject)
    get_property(chapter GLOBAL PROPERTY doc_active)
    get_property(code GLOBAL PROPERTY doc_${chapter}_${index}_code)
    file(WRITE "${TEST_DIR}/diagnostics/${name}.brf" "main() {\n${code}\n}\n")
    set_property(GLOBAL APPEND PROPERTY native_diagnostics "${name}")
    math(EXPR remainder "(${ARGC} - 2) % 2")
    if(ARGC LESS 4 OR NOT remainder EQUAL 0)
        message(FATAL_ERROR "${name}: expected diagnostic message/line pairs")
    endif()
    set(at 2)
    while(at LESS ARGC)
        math(EXPR next "${at} + 1")
        set(line "${ARGV${next}}")
        if(NOT line MATCHES "^[1-9][0-9]*$")
            message(FATAL_ERROR "${name}: invalid original fence line")
        endif()
        math(EXPR line "${line} + 1")
        native_expect_diagnostic("${name}" "${ARGV${at}}" "${line}")
        math(EXPR at "${at} + 2")
    endwhile()
endfunction()

function(native_prose name source)
    native_case("${name}" prose prose)
    file(WRITE "${TEST_DIR}/programs/${name}.brf" "${source}")
    set_property(GLOBAL APPEND PROPERTY native_programs "${name}")
endfunction()

# Full existing examples are independent cases, never substituted raw listing
# coverage. Source hashes force review; only committed expectations are appended.
function(native_example name hash)
    native_case("${name}" independent example)
    set(relative "examples/${name}.brf")
    file(SHA256 "${ROOT}/${relative}" actual)
    if(NOT actual STREQUAL hash)
        message(FATAL_ERROR "${relative}: example source changed; review expectations")
    endif()
    read_doc_bytes("${ROOT}/${relative}" source)
    read_doc_bytes("${ROOT}/tests/examples/${name}.expect" expectations)
    file(WRITE "${TEST_DIR}/programs/${name}.brf" "${source}\n${expectations}")
    set_property(GLOBAL APPEND PROPERTY native_programs "${name}")
    set_property(GLOBAL APPEND PROPERTY native_example_sources "${relative}")
endfunction()

function(native_finish programs diagnostics listings prose)
    set(examples 0)
    if(ARGC GREATER 4)
        set(examples "${ARGV4}")
    endif()
    get_property(chapter GLOBAL PROPERTY doc_active)
    get_property(count GLOBAL PROPERTY doc_count)
    set(first 1)
    if(count EQUAL 0)
        set(first 0)
    endif()
    foreach(index RANGE ${first} ${count})
        get_property(kind GLOBAL PROPERTY doc_${chapter}_${index}_kind)
        get_property(cases GLOBAL PROPERTY native_${index}_cases)
        if(kind MATCHES "^(run|reject)$" AND NOT cases)
            message(FATAL_ERROR "${chapter}:${index}: native classification has no case")
        endif()
    endforeach()
    foreach(kind programs diagnostics listings prose examples)
        get_property(cases GLOBAL PROPERTY native_${kind})
        list(LENGTH cases actual)
        if(NOT actual EQUAL ${kind})
            message(FATAL_ERROR "${chapter}: ${kind} count changed (${actual}, expected ${${kind}})")
        endif()
    endforeach()
    if(examples GREATER 0)
        file(GLOB actual_examples RELATIVE "${ROOT}" "${ROOT}/examples/*.brf")
        get_property(expected_examples GLOBAL PROPERTY native_example_sources)
        list(SORT actual_examples)
        list(SORT expected_examples)
        if(NOT actual_examples STREQUAL expected_examples)
            message(FATAL_ERROR "${chapter}: example inventory changed")
        endif()
    endif()
    file(GLOB files "${TEST_DIR}/programs/*.brf")
    list(LENGTH files actual)
    if(NOT actual EQUAL programs)
        message(FATAL_ERROR "${chapter}: program files do not match cases")
    endif()
    end_chapter()
    message(STATUS "${chapter}: ${programs} runner cases (${prose} prose, ${examples} independent examples), ${diagnostics} whole-fence diagnostics, ${listings} explicit listings")
endfunction()

function(native_execute)
    get_property(names GLOBAL PROPERTY native_diagnostics)
    foreach(name IN LISTS names)
        set(path "${TEST_DIR}/diagnostics/${name}.brf")
        execute_process(COMMAND "${BRIEF}" emit-c "${path}"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
        get_property(expected_count GLOBAL PROPERTY native_${name}_count)
        string(REGEX MATCHALL "(^|\n)error:" messages "${errors}")
        list(LENGTH messages count)
        file(WRITE "${TEST_DIR}/diagnostics/${name}.log" "${errors}")
        if(NOT status EQUAL 1 OR NOT output STREQUAL "" OR NOT count EQUAL expected_count OR
           errors MATCHES "AddressSanitizer|LeakSanitizer|UndefinedBehaviorSanitizer|runtime error:")
            message(FATAL_ERROR "${name}: expected ${expected_count} exact diagnostics and no C (${status}):\n${errors}\n${output}")
        endif()
        set(rest "${errors}")
        foreach(index RANGE 1 ${expected_count})
            string(FIND "${rest}" "\nerror:" next)
            if(next LESS 0)
                set(diagnostic "${rest}")
            else()
                string(SUBSTRING "${rest}" 0 ${next} diagnostic)
                math(EXPR next "${next} + 1")
                string(SUBSTRING "${rest}" ${next} -1 rest)
            endif()
            get_property(expected GLOBAL PROPERTY native_${name}_${index}_message)
            get_property(line GLOBAL PROPERTY native_${name}_${index}_line)
            string(REGEX MATCH "^error: [^\n]*" message "${diagnostic}")
            string(REGEX MATCH "--> [^\n]*:([0-9]+):[0-9]+" location "${diagnostic}")
            set(actual_line "${CMAKE_MATCH_1}")
            if(NOT message STREQUAL "error: ${expected}" OR NOT actual_line STREQUAL line)
                message(FATAL_ERROR "${name}: diagnostic ${index} differs on source line ${line}:\n${diagnostic}")
            endif()
            native_check_fixes("${name}" "${index}" "${diagnostic}")
        endforeach()
    endforeach()
    set(options)
    if(DEBUG)
        list(APPEND options --debug)
    endif()
    execute_process(COMMAND "${RUNNER}" --brief "${BRIEF}" --cc "${CC}"
        --programs "${TEST_DIR}/programs" ${options}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 120)
    file(WRITE "${TEST_DIR}/runner.log" "${output}${errors}")
    if(NOT status EQUAL 0 OR NOT errors STREQUAL "")
        message(FATAL_ERROR "Native document cases failed (${status}):\n${output}\n${errors}")
    endif()
    message(STATUS "${output}")
endfunction()
