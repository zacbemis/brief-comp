cmake_minimum_required(VERSION 3.16)

# Each child must fail at the intended guard, before it can turn an incomplete
# manifest into a passing acceptance claim. No compiler/interpreter is needed.
if(NOT DEFINED MODE)
    set(expected_count "fence count changed")
    set(expected_unclosed "Unclosed fixture code fence")
    set(expected_missing "Missing example adapter anchor")
    set(expected_ambiguous "Ambiguous example adapter anchor")
    set(expected_duplicate "Invalid or duplicate example name")
    set(expected_index "Invalid fixture fence index")
    set(expected_omitted "needs exactly one scope classification")
    set(expected_overlap "needs exactly one scope classification")
    set(expected_classification "Invalid fixture classification index")
    set(expected_cases "case count changed")
    set(expected_runner "fixture acceptance failed")
    set(expected_zero-index "Invalid fixture fence index")
    set(expected_zero-classification "Invalid fixture classification index")
    set(expected_zero-runner "fixture acceptance failed")
    set(expected_return-arrows "frozen return-arrow bridge needs review")
    foreach(mode IN ITEMS count unclosed missing ambiguous duplicate index
            omitted overlap classification cases runner
            zero-index zero-classification zero-runner return-arrows)
        execute_process(COMMAND "${CMAKE_COMMAND}" -DMODE=${mode}
            "-DTEST_DIR=${TEST_DIR}/${mode}" -P "${CMAKE_CURRENT_LIST_FILE}"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        string(REGEX REPLACE "[\r\n ]+" " " words "${errors}")
        if(status EQUAL 0 OR NOT words MATCHES "${expected_${mode}}")
            message(FATAL_ERROR "Acceptance guard ${mode} did not fail as intended (${status}):\n${output}\n${errors}")
        endif()
    endforeach()
    include("${CMAKE_CURRENT_LIST_DIR}/doc_return_arrows.cmake")
    get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
    set(code "getAge(user: User): int { 1 }\nunlisted(): int { 1 }")
    doc_return_arrows(code lang-memory)
    if(NOT code STREQUAL "getAge(user: User) -> int { 1 }\nunlisted(): int { 1 }")
        message(FATAL_ERROR "The frozen bridge must change only listed headers")
    endif()
    message(STATUS "Checked 15 acceptance-harness failure guards and the bounded arrow bridge")
    return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/doc_examples.cmake")
set(ROOT "${TEST_DIR}/root")
file(MAKE_DIRECTORY "${ROOT}/docs/v0")
if(MODE STREQUAL "return-arrows")
    file(WRITE "${ROOT}/docs/v0/lang-memory.txt" "drifted chapter")
    set(code "getAge(user: User): int { 1 }")
    doc_return_arrows(code lang-memory)
    message(FATAL_ERROR "Return-arrow drift guard unexpectedly accepted input")
endif()
if(MODE MATCHES "^zero-")
    file(WRITE "${ROOT}/docs/v0/fixture.txt" "A prose-only document.\n")
    doc_examples_begin(fixture 0)
    if(MODE STREQUAL "zero-index")
        example(1 invalid "" "main() {}" "")
    elseif(MODE STREQUAL "zero-classification")
        doc_examples_finish("1" "" 0)
    else()
        # A valid prose case must pass classification and reach the runner.
        example(0 prose "" "main() {}" "")
        set(RUNNER "${CMAKE_COMMAND}")
        set(BRIEF unused)
        set(CC unused)
        doc_examples_finish("" "" 1)
    endif()
    message(FATAL_ERROR "Guard ${MODE} unexpectedly accepted invalid input")
endif()
file(WRITE "${ROOT}/docs/v0/fixture.txt" "```\nmain() {}\n```\n\n```\nmain() {}\n```\n")
if(MODE STREQUAL "count")
    doc_examples_begin(fixture 3)
elseif(MODE STREQUAL "unclosed")
    file(WRITE "${ROOT}/docs/v0/fixture.txt" "```\nmain() {}\n")
    doc_examples_begin(fixture 2)
else()
    doc_examples_begin(fixture 2)
endif()
if(MODE STREQUAL "missing")
    set(code "a")
    replace_once(code "missing" "b")
elseif(MODE STREQUAL "ambiguous")
    set(code "aa")
    replace_once(code "a" "b")
elseif(MODE STREQUAL "duplicate")
    example(1 same "" "main() {}" "")
    example(2 same "" "overwritten" "")
elseif(MODE STREQUAL "index")
    example(3 invalid "" "main() {}" "")
else()
    example(1 valid "" "main() {}" "")
    if(MODE STREQUAL "omitted")
        doc_examples_finish("" "" 1)
    elseif(MODE STREQUAL "overlap")
        doc_examples_finish("1;2" "" 1)
    elseif(MODE STREQUAL "classification")
        doc_examples_finish("3" "" 1)
    elseif(MODE STREQUAL "cases")
        doc_examples_finish("2" "" 2)
    elseif(MODE STREQUAL "runner")
        # cmake rejects --brief: exercise runner-failure forwarding without a
        # shell script, platform-specific executable, or native compilation.
        set(RUNNER "${CMAKE_COMMAND}")
        set(BRIEF unused)
        set(CC unused)
        doc_examples_finish("2" "" 1)
    endif()
endif()
message(FATAL_ERROR "Guard ${MODE} unexpectedly accepted invalid input")
