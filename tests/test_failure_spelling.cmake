cmake_minimum_required(VERSION 3.16)

# Full-source checks for this N1 migration, not outcome-policy/native audits.
# The compiler must retain every explicit kind in types, values and patterns.
function(check_spelling relative error_names neutral_names)
    execute_process(COMMAND "${BRIEF}" dump-ast "${SOURCE_DIR}/${relative}"
        RESULT_VARIABLE status OUTPUT_VARIABLE tree ERROR_VARIABLE errors)
    if(NOT status EQUAL 0 OR NOT errors STREQUAL "" OR NOT tree MATCHES "^\\(program")
        message(FATAL_ERROR "${relative}: cannot check tag spelling (${status}): ${errors}")
    endif()
    string(REPLACE "," ";" error_names "${error_names}")
    string(REPLACE "," ";" neutral_names "${neutral_names}")
    foreach(tag IN LISTS error_names)
        if(NOT tree MATCHES "\\((:|symbol |tag )!${tag}([ )])" OR
           tree MATCHES "\\((:|symbol |tag )${tag}([ )])")
            message(FATAL_ERROR "${relative}: '${tag}' must use :! at every source occurrence")
        endif()
    endforeach()
    foreach(tag IN LISTS neutral_names)
        if(NOT tree MATCHES "\\((:|symbol |tag )${tag}([ )])" OR
           tree MATCHES "\\((:|symbol |tag )!${tag}([ )])")
            message(FATAL_ERROR "${relative}: '${tag}' must retain its neutral spelling")
        endif()
    endforeach()
    if(tree MATCHES "\\((:|symbol |tag )!(ok|none)([ )])")
        message(FATAL_ERROR "${relative}: shared ok/none must remain neutral")
    endif()
endfunction()

check_spelling(examples/bank.brf "noAccount,badAmount,frozen,insufficient,sameAccount" "none")
