# Current-document parser inventory. No v0 reads, syntax rewriting or extraction.
include_guard(GLOBAL)
function(chapter name expected_count expected_hash)
    get_property(active GLOBAL PROPERTY doc_active)
    get_property(names GLOBAL PROPERTY doc_names)
    if(active OR name IN_LIST names)
        message(FATAL_ERROR "Duplicate/nested document chapter: ${name}")
    endif()
    file(SHA256 "${ROOT}/docs/${name}.txt" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "${name}: parser inventory needs review (document changed)")
    endif()
    file(READ "${ROOT}/docs/${name}.txt" rest)
    set(count 0)
    while(TRUE)
        string(FIND "${rest}" "```" opening)
        if(opening LESS 0)
            break()
        endif()
        math(EXPR opening "${opening} + 3")
        string(SUBSTRING "${rest}" ${opening} -1 rest)
        string(FIND "${rest}" "\n" newline)
        if(newline LESS 0)
            message(FATAL_ERROR "${name}: unclosed fence")
        endif()
        math(EXPR newline "${newline} + 1")
        string(SUBSTRING "${rest}" ${newline} -1 rest)
        string(FIND "${rest}" "```" closing)
        if(closing LESS 0)
            message(FATAL_ERROR "${name}: unclosed fence")
        endif()
        math(EXPR count "${count} + 1")
        string(SUBSTRING "${rest}" 0 ${closing} code)
        set_property(GLOBAL PROPERTY doc_${name}_${count}_code "${code}")
        math(EXPR closing "${closing} + 3")
        string(SUBSTRING "${rest}" ${closing} -1 rest)
    endwhile()
    if(NOT count EQUAL expected_count)
        message(FATAL_ERROR "${name}: fence count changed (${count})")
    endif()
    set_property(GLOBAL APPEND PROPERTY doc_names "${name}")
    set_property(GLOBAL PROPERTY doc_active "${name}")
    set_property(GLOBAL PROPERTY doc_count "${count}")
endfunction()
# Keep import lines at file scope and wrap all remaining usage, unchanged.
# This is a context wrapper, not extraction, stubbing or a module loader.
function(wrap_import_body code output)
    string(FIND "${code}" "\n\n" split)
    if(split LESS 0)
        message(FATAL_ERROR "missing import/usage boundary")
    endif()
    string(SUBSTRING "${code}" 0 ${split} imports)
    if(imports STREQUAL "")
        message(FATAL_ERROR "invalid import wrapper prefix")
    endif()
    string(REPLACE "\n" ";" lines "${imports}")
    foreach(line IN LISTS lines)
        if(NOT line MATCHES "^import[ \t]+[^ \t]+[ \t]*$")
            message(FATAL_ERROR "invalid import wrapper prefix")
        endif()
    endforeach()
    string(SUBSTRING "${code}" ${split} -1 usage)
    set(${output} "${imports}\nmain() {${usage}\n}\n" PARENT_SCOPE)
endfunction()
function(fences kind reason indices)
    get_property(name GLOBAL PROPERTY doc_active)
    get_property(count GLOBAL PROPERTY doc_count)
    if(NOT name OR reason STREQUAL "" OR NOT kind MATCHES "^(body|top|mixed|import-body|error-body|error-top|n[1-6]|later|fragment|raw)$")
        message(FATAL_ERROR "Invalid document classification: ${kind}")
    endif()
    foreach(index IN LISTS indices)
        if(NOT index MATCHES "^[0-9]+$" OR index GREATER count OR
           (index EQUAL 0 AND (NOT count EQUAL 0 OR NOT kind STREQUAL "raw")) OR
           (index GREATER 0 AND kind STREQUAL "raw"))
            message(FATAL_ERROR "${name}: invalid fence index ${index}")
        endif()
        get_property(previous GLOBAL PROPERTY doc_${name}_${index}_kind)
        if(previous)
            message(FATAL_ERROR "${name}:${index}: duplicate classification")
        endif()
        set_property(GLOBAL PROPERTY doc_${name}_${index}_kind "${kind}")
        file(APPEND "${TEST_DIR}/inventory.txt" "${name}:${index} ${kind}: ${reason}\n")
        if(kind MATCHES "^(n[1-6]|later|fragment|raw)$")
            set_property(GLOBAL APPEND PROPERTY doc_listed "${name}:${index}")
            continue()
        endif()
        get_property(code GLOBAL PROPERTY doc_${name}_${index}_code)
        if(kind STREQUAL "import-body")
            wrap_import_body("${code}" code)
        elseif(kind MATCHES "body$")
            set(code "main() {\n${code}\n}\n")
        elseif(kind STREQUAL "mixed")
            string(FIND "${code}" "\nlet " split)
            if(split LESS 0)
                message(FATAL_ERROR "${name}:${index}: missing mixed declaration/usage boundary")
            endif()
            string(SUBSTRING "${code}" 0 ${split} definitions)
            string(SUBSTRING "${code}" ${split} -1 usage)
            set(code "${definitions}\nmain() {\n${usage}\n}\n")
        endif()
        set(path "${TEST_DIR}/${name}-${index}.brf")
        file(WRITE "${path}" "${code}")
        execute_process(COMMAND "${BRIEF}" dump-ast "${path}"
            RESULT_VARIABLE status OUTPUT_VARIABLE tree ERROR_VARIABLE errors TIMEOUT 5)
        if(kind MATCHES "^error-")
            if(NOT status EQUAL 1 OR NOT tree STREQUAL "" OR NOT errors MATCHES "^error:")
                message(FATAL_ERROR "${name}:${index}: expected syntax rejection (${status}):\n${errors}\n${tree}")
            endif()
        elseif(NOT status EQUAL 0 OR NOT errors STREQUAL "" OR NOT tree MATCHES "^\\(program")
            message(FATAL_ERROR "${name}:${index}: failed parsing (${status}):\n${errors}\n${code}")
        endif()
        set_property(GLOBAL APPEND PROPERTY doc_tested "${name}:${index}")
    endforeach()
endfunction()
function(end_chapter)
    get_property(name GLOBAL PROPERTY doc_active)
    get_property(count GLOBAL PROPERTY doc_count)
    if(NOT name)
        message(FATAL_ERROR "No active document chapter")
    endif()
    if(count EQUAL 0)
        set(first 0)
    else()
        set(first 1)
    endif()
    foreach(index RANGE ${first} ${count})
        get_property(kind GLOBAL PROPERTY doc_${name}_${index}_kind)
        if(NOT kind)
            message(FATAL_ERROR "${name}:${index}: missing classification")
        endif()
    endforeach()
    set_property(GLOBAL PROPERTY doc_active "")
endfunction()
function(finish_documents)
    get_property(active GLOBAL PROPERTY doc_active)
    if(active)
        message(FATAL_ERROR "Unfinished document chapter: ${active}")
    endif()
    file(GLOB paths "${ROOT}/docs/lang-*.txt")
    set(expected "")
    foreach(path IN LISTS paths)
        get_filename_component(name "${path}" NAME_WE)
        if(NOT name STREQUAL "lang-post-0-notes")
            list(APPEND expected "${name}")
        endif()
    endforeach()
    get_property(names GLOBAL PROPERTY doc_names)
    list(SORT names)
    list(SORT expected)
    if(NOT names STREQUAL expected)
        message(FATAL_ERROR "Document chapter inventory changed")
    endif()
    get_property(tested GLOBAL PROPERTY doc_tested)
    get_property(listed GLOBAL PROPERTY doc_listed)
    list(LENGTH tested tested_count)
    list(LENGTH listed listed_count)
    list(LENGTH names chapter_count)
    message(STATUS "${chapter_count} current chapters: ${tested_count} parser checks, ${listed_count} explicit listings; see ${TEST_DIR}/inventory.txt")
endfunction()
