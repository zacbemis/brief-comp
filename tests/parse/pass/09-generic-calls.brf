// Square brackets give type arguments without guessing or backtracking.
// These calls retain the coverage of the old angle-ambiguity fixture.
// Formerly ambiguous calls are explicit now; commas and comparisons are
// ordinary operators. New unparenthesized comparison cases are also checked
// independently in test_parser and test_sema.

main() {
  // Generic calls.
  let users = Vec[User]()
  let grid = Vec[Vec[int]]()
  let cube = Vec[Vec[Vec[int]]]()
  let lookup = Map[str, Vec[int]]()
  let results = Vec[:ok[int] | :none]()
  let nested = Vec[:ok[Vec[int]] | :none]()
  let qualified = models.Vec[User]()
  let method = json.read[User](text)
  let chained = Vec[User]().first()
  let unwrapped = load[User](path)?.name
  let spaced = Vec [ User ] ()
  let multiline = Map[
    str,
    int]()
  let selfType = Vec[Self]()
  let arrays = Vec[Arr[int]]()

  // Comparisons.
  let smaller = a < b
  let inside = a < b and b > c
  let notCall = a < b and c > (d)
  let bothSides = (a < b) == (c > d)
  let shifted = a < b >> c          // a < (b >> c), never a type argument
  let shiftedCall = a < b >> (c)    // ordinary shift with a grouped operand
  let lessEqual = a <= b
  let negative = a < -b
  let callRight = a < f(b)
  let fieldLeft = user.age < limit

  // Inside call arguments.
  check(a < b, c > d)               // two comparisons
  check((a < b), (c > (d)))         // two comparisons
  check(a[b, c](d))                 // explicit formerly ambiguous call
  check(a[b](c))                    // explicit formerly ambiguous call
  check(a < b, c >= (d))            // two comparisons

  // A generic call in a condition: the `{` after it starts the body.
  if Vec[int]().isEmpty() {
    print("empty")
  }
  while count < limit {
    count += 1
  }
}
