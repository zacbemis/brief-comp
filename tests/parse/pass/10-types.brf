// Type syntax in every position: annotations, parameters, fields, returns,
// aliases and union entries. Union bars continue lines; final members and
// bracketed payloads/arguments preserve the next field/declaration separator.

Simple = :a
WithPayload = :ok[int] | :err[str]
Nested = :ok[:inner[int] | :none] | :outer
Merged = Simple | WithPayload | :extra
Qualified = Json.Error | File.Error
Applied = Vec[int]
Deep = Map[str, Vec[Vec[int]]]
Array = Arr[int]
Grid = Arr[Arr[int]]
Unit = ()
TrailingComma = :a | :b
Multiline =
  :notFound[str] |
  :denied[str] |
  :tooLarge[lng]
LastAfterMultiline = :z

Holder {
  plain: int
  generic: Vec[User]
  nested: Vec[Vec[int]]
  tripleClose: Vec[Vec[Vec[int]]]
  symbol: :ok[Node] | :none
  symbolNested: Vec[:ok[int] | :none]
  qualified: models.Box[int]
  array: Arr[int]
  unit: ()
  last: str


  pub same(holder: Holder) -> Holder {
    holder
  }

  pub get(holder: &Holder, index: int) -> :ok[int] | :outOfRange[int] {
    :ok[holder.plain]
  }
}

AllPrimitives {
  a: bool
  b: int
  c: uint
  d: shrt
  e: ushrt
  f: lng
  g: ulng
  h: flt
  i: dbl
  j: chr
  k: str
}


returnsGeneric() -> Vec[int] {
  Vec[int]()
}

returnsNestedGeneric() -> Map[str, Vec[int]] {
  Map[str, Vec[int]]()
}

returnsSym() -> :ok[Vec[int]] | :none {
  :none
}

returnsPartial() -> :ok[int] | _ {
  :ok[1]
}

returnsUnit() -> () {
}

returnsArray() -> Arr[int] {
  make()
}

