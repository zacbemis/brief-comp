}

main() {
  let a: int = 1
  let b: Vec<User> = Vec<User>()
  let c: Sym<:ok(int), :none> = :none
  var d: Map<str, Vec<int>> = Map<str, Vec<int>>()
  let e: int[3] = make()
  let f: () = ()
  let g: Vec<Vec<int>> = Vec<Vec<int>>()
  let h: lng = 10
