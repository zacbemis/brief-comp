// Self is an ordinary uppercase name, not an implicit owner type.
Self { value: int

  new(value: int) -> Self { Self { value = value } }
}
Alias = Self
Nested = Vec[Self]
Result = :ok[Self] | :!missing
Holder { value: Self

  wrap(value: Self) -> Holder { Holder { value = value } }
}
main() {
  let value: Self = Self.new(1)
  value |> { :ok[Self] => () }
}
