// Assignment and compound assignment are statements whose target is a
// binding, a field, or an indexed element (lang-syntax.txt, "Operators").

main() {
  var count = 0
  count = 1
  count += 1
  count -= 1
  count *= 2
  count /= 2
  count %= 3
  user.age = 20
  user.age += 1
  user.home.street = "Main"
  grid[0] = 1
  grid[i][j] = 2
  grid[i + 1] *= 3
  users[0].age = 4
  find(name)!.age = 5
  load()?.count += 1
  lookup().items[0] = 6

  // The right-hand side is any expression, including one that spans lines.
  count = a +
    b
  count = if ready { 1 } else { 2 }
  count = value |> {
    _ => 3
  }
  total = items
    |> sum()

  // Assignments inside blocks, branches, and loops.
  if ready {
    count = 0
  } else {
    count = 1
  }
  while count < 10 {
    count += 1
  }
}
