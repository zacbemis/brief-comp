// A realistic first-version program in the style of docs/lang-ex-base.txt,
// without the later-version features (lambdas, traits, tuples, modules).

Tier = :tier1 | :tier2 | :tier3
Error = :!invalidAge[int] | :!emptyName

const minAge = 0
const maxAge: int = 150

User {
  name: str
  age: int
  tier: Tier


  pub new(name: str, age: int) -> :ok[User] | Error {
    if name == "" {
      ret :!emptyName
    }
    if age < minAge or age > maxAge {
      ret :!invalidAge[age]
    }
    User { name = name, age = age, tier = :tier1 }
  }

  pub getName() -> str {
    self.name
  }

  pub getAgeRange() -> :minor | :adult | :senior {
    self.age |> {
      < 18 => :minor
      18..65 => :adult
      >= 65 => :senior
    }
  }

  pub promote(&self) {
    self.tier = self.tier |> {
      :tier1 => :tier2
      _ => :tier3
    }
  }

  pub describe() -> str {
    let range = self.getAgeRange() |> {
      :minor => "minor"
      :adult => "adult"
      :senior => "senior"
    }
    self.name + " (" + range + ", " + str(self.age) + ")"
  }
}

Admin {
  user: User
  level: int


  pub new(name: str, age: int) -> :ok[Admin] | Error {
    Admin { user = User.new(name, age)?, level = 1 }
  }
}



countAdults(limit: int) -> int {
  var count = 0
  var age = 0
  while age < limit {
    age += 1
    if age < 18 {
      continue
    }
    count += 1
    if count >= 100 {
      break
    }
  }
  count
}

sumTo(n: int) {
  var total = 0
  for i in 0..n + 1 {
    total += i
  }
  total
}

classify(n: int) -> str {
  if n < 0 { "negative" } else if n == 0 { "zero" } else { "positive" }
}

main() {
  let bob = User.new("Bob", 42)!
  var admin = Admin.new("Ann", 30)!
  admin.user.promote()

  User.new("", 10) |> {
    :ok[user] => print(user.describe())
    :!emptyName => print("A name is required")
    :!invalidAge[age] => print("Not a valid age: " + str(age))
  }

  print(bob.describe())
  print(countAdults(200) |> str())
  print(str(sumTo(10)))
  print(classify(-5))
}
