// Indexing uses a single .( opener; newlines are enclosed as in calls.
main() {
  rows
    .(
      columns.(0)
    )
    .(next())
  rows.(P {
    x = 0
    y = 1
  }.x)
  rows.(if ready { 0 } else { 1 })
  rows.(value |> {
    :first => 0
    _ => 1
  })
  let item = not rows.(0)! != rows.(1)
  rows.(0).age += 1
  rows.(0).items.(1)--
  rows.(0).get()?!
  if rows.(0) { rows.(1) }
  while rows.(0) { break }
  for row in rows.(0) { row }
}
