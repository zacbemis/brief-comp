// Every kind of first-version top-level declaration, with each return-type
// form: inferred, written, partial (`_`), and the empty type.

const limit = 100
pub const version: flt = 0.5

Tier = :bronze | :silver | :gold
Error = :notFound[str] | :denied[str]

User {
  name: str
  age: int
  tier: Tier
}

Empty { unit: ()
}

Point { x: dbl
  y: dbl }

impl User {
  pub new(name: str, age: int) -> :ok[User] | :invalidAge[int] {
    if age < 0 {
      ret :invalidAge[age]
    }
    User { name = name, age = age, tier = :bronze }
  }

  pub getName(user: User) -> str {
    user.name
  }

  // An inferred return type.
  pub isAdult(user: User) {
    user.age >= 18
  }

  // A partial return type.
  pub load(text: str) -> :ok[User] | _ {
    User.new(text, 20)?
  }

  // Returns the empty type.
  pub birthday(user: &User) -> () {
    user.age += 1
  }
}

impl Empty {
}

noParams() {
}

oneParam(x: int) {
  x
}

trailingComma(a: int, b: int,) {
  a + b
}

borrowed(a: &User, b: User, c: &Point) {
  a.age = b.age
}

namedSetsInReturn(path: str) -> :ok[str] | Error | :tooLong[int] {
  :ok[path]
}

payloadlessOk() -> :ok | :failed {
  :ok
}

main() {
  let user = User.new("Bob", 20)!
  print(user.getName())
}
