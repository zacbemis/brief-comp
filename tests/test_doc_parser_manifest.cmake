cmake_minimum_required(VERSION 3.16)
if(NOT DEFINED MODE)
    set(expected_hash "inventory needs review")
    set(expected_count "fence count changed")
    set(expected_unclosed "unclosed fence")
    set(expected_duplicate "duplicate classification")
    set(expected_omitted "missing classification")
    set(expected_index "invalid fence index")
    set(expected_raw "invalid fence index")
    set(expected_kind "Invalid document classification")
    set(expected_reason "Invalid document classification")
    set(expected_chapter "Duplicate/nested")
    set(expected_unfinished "Unfinished document chapter")
    set(expected_inventory "chapter inventory changed")
    set(expected_mixed "missing mixed declaration/usage boundary")
    set(expected_import_boundary "missing import/usage boundary")
    set(expected_import_prefix "invalid import wrapper prefix")
    set(expected_type_empty "empty type wrapper")
    foreach(mode IN ITEMS hash count unclosed duplicate omitted index raw kind reason chapter unfinished inventory mixed import_boundary import_prefix type_empty)
        execute_process(COMMAND "${CMAKE_COMMAND}" -DMODE=${mode}
            "-DTEST_DIR=${TEST_DIR}/${mode}" -P "${CMAKE_CURRENT_LIST_FILE}"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        string(REGEX REPLACE "[\r\n ]+" " " words "${errors}")
        if(status EQUAL 0 OR NOT words MATCHES "${expected_${mode}}")
            message(FATAL_ERROR "Parser manifest ${mode} guard failed (${status}):\n${output}\n${errors}")
        endif()
    endforeach()
    # Validate listing and zero-fence accounting without invoking a compiler.
    include("${CMAKE_CURRENT_LIST_DIR}/doc_parser.cmake")
    wrap_import_body("import models.User\nimport std.Json\n\nUser.new()\n" wrapped)
    if(NOT wrapped STREQUAL "import models.User\nimport std.Json\nmain() {\n\nUser.new()\n\n}\n")
        message(FATAL_ERROR "Import wrapper changed or lost source text: ${wrapped}")
    endif()
    wrap_type(" :ok[User] |\r\n :!bad[int] \n" wrapped)
    if(NOT wrapped STREQUAL "DocType =\n :ok[User] |\r\n :!bad[int] \n\n")
        message(FATAL_ERROR "Type wrapper changed or lost source text: ${wrapped}")
    endif()
    set(ROOT "${TEST_DIR}/positive")
    file(MAKE_DIRECTORY "${ROOT}/docs")
    file(WRITE "${ROOT}/docs/lang-fixture.txt" "```\nAlias = int\n```\n")
    file(SHA256 "${ROOT}/docs/lang-fixture.txt" hash)
    chapter(lang-fixture 1 "${hash}")
    fences(n1 "Explicitly listed, not a passing parser test" "1")
    end_chapter()
    file(WRITE "${ROOT}/docs/lang-empty.txt" "A raw sample with no fences.\n")
    file(SHA256 "${ROOT}/docs/lang-empty.txt" hash)
    chapter(lang-empty 0 "${hash}")
    fences(raw "Explicit raw/prose classification" "0")
    end_chapter()
    finish_documents()
    get_property(tested GLOBAL PROPERTY doc_tested)
    get_property(listed GLOBAL PROPERTY doc_listed)
    list(LENGTH listed count)
    if(tested OR NOT count EQUAL 2)
        message(FATAL_ERROR "Listings must not count as passing parser tests")
    endif()
    message(STATUS "Checked 16 manifest guards, import/type wrappers, listings and zero-fence accounting")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/doc_parser.cmake")
set(ROOT "${TEST_DIR}/root")
file(MAKE_DIRECTORY "${ROOT}/docs")
file(WRITE "${ROOT}/docs/lang-fixture.txt" "```\nAlias = int\n```\n")
if(MODE STREQUAL "unclosed")
    file(WRITE "${ROOT}/docs/lang-fixture.txt" "```\nAlias = int\n")
endif()
file(SHA256 "${ROOT}/docs/lang-fixture.txt" hash)
if(MODE STREQUAL "hash")
    set(hash wrong)
endif()
set(count 1)
if(MODE STREQUAL "count")
    set(count 2)
endif()
chapter(lang-fixture ${count} "${hash}")
if(MODE STREQUAL "index")
    fences(n1 "Invalid index" "0")
elseif(MODE STREQUAL "raw")
    fences(raw "Not a raw chapter" "1")
elseif(MODE STREQUAL "kind")
    fences(unknown "Invalid kind" "1")
elseif(MODE STREQUAL "reason")
    fences(n1 "" "1")
elseif(MODE STREQUAL "chapter")
    chapter(lang-fixture 1 "${hash}")
elseif(MODE STREQUAL "unfinished")
    finish_documents()
elseif(MODE STREQUAL "mixed")
    fences(mixed "No declaration/usage boundary" "1")
elseif(MODE STREQUAL "import_boundary")
    wrap_import_body("import models.User\nUser.new()\n" wrapped)
elseif(MODE STREQUAL "import_prefix")
    wrap_import_body("A = int\n\nUser.new()\n" wrapped)
elseif(MODE STREQUAL "type_empty")
    wrap_type(" \t\r\n" wrapped)
elseif(MODE STREQUAL "omitted")
    end_chapter()
else()
    fences(n1 "Deliberately listed" "1")
    if(MODE STREQUAL "duplicate")
        fences(later "A duplicate listing" "1")
    endif()
    end_chapter()
    if(MODE STREQUAL "inventory")
        file(WRITE "${ROOT}/docs/lang-extra.txt" "Unclassified new chapter")
        finish_documents()
    endif()
endif()
message(FATAL_ERROR "Manifest guard ${MODE} unexpectedly accepted input")
