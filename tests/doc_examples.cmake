# Shared native acceptance support for design-document examples.
# Callers set ROOT, TEST_DIR, BRIEF, RUNNER, CC and optionally DEBUG.
include_guard(GLOBAL)

function(doc_examples_begin filename expected_count)
    file(READ "${ROOT}/docs/${filename}.txt" rest)
    set(count 0)
    while(TRUE)
        string(FIND "${rest}" "```" opening)
        if(opening LESS 0)
            break()
        endif()
        math(EXPR opening "${opening} + 3")
        string(SUBSTRING "${rest}" ${opening} -1 rest)
        string(FIND "${rest}" "\n" newline)
        if(newline LESS 0)
            message(FATAL_ERROR "Unclosed ${filename} code fence")
        endif()
        math(EXPR newline "${newline} + 1")
        string(SUBSTRING "${rest}" ${newline} -1 rest)
        string(FIND "${rest}" "```" closing)
        if(closing LESS 0)
            message(FATAL_ERROR "Unclosed ${filename} code fence")
        endif()
        math(EXPR count "${count} + 1")
        string(SUBSTRING "${rest}" 0 ${closing} code)
        set(block_${count} "${code}" PARENT_SCOPE)
        math(EXPR closing "${closing} + 3")
        string(SUBSTRING "${rest}" ${closing} -1 rest)
    endwhile()
    if(NOT count EQUAL expected_count)
        message(FATAL_ERROR "${filename} fence count changed (${count}); update its acceptance audit")
    endif()
    set(example_document "${filename}" PARENT_SCOPE)
    set(example_fence_count ${count} PARENT_SCOPE)
    set_property(GLOBAL PROPERTY checked_fences "")
    set_property(GLOBAL PROPERTY example_cases "")
    file(REMOVE_RECURSE "${TEST_DIR}/programs")
    file(MAKE_DIRECTORY "${TEST_DIR}/programs")
endfunction()

# Adapt only explicit fragment boundaries/signatures; fail if an anchor drifts.
function(replace_once variable needle replacement)
    set(code "${${variable}}")
    string(FIND "${code}" "${needle}" at)
    if(at LESS 0)
        message(FATAL_ERROR "Missing example adapter anchor: ${needle}")
    endif()
    string(LENGTH "${needle}" size)
    math(EXPR end "${at} + ${size}")
    string(SUBSTRING "${code}" 0 ${at} before)
    string(SUBSTRING "${code}" ${end} -1 after)
    string(FIND "${after}" "${needle}" duplicate)
    if(NOT duplicate LESS 0)
        message(FATAL_ERROR "Ambiguous example adapter anchor: ${needle}")
    endif()
    set(${variable} "${before}${replacement}${after}" PARENT_SCOPE)
endfunction()
function(error_at variable needle message)
    string(FIND "${${variable}}" "${needle}" at)
    if(at LESS 0)
        message(FATAL_ERROR "Missing error anchor: ${needle}")
    endif()
    string(SUBSTRING "${${variable}}" ${at} -1 tail)
    string(FIND "${tail}" "\n" end)
    if(end LESS 0)
        string(LENGTH "${tail}" end)
    endif()
    string(SUBSTRING "${tail}" 0 ${end} line)
    replace_once(${variable} "${line}" "${line} // error: ${message}")
    set(${variable} "${${variable}}" PARENT_SCOPE)
endfunction()

function(example index name prefix code suffix)
    # Index 0 is reserved for examples drawn from inline code/prose.
    if(index LESS 0 OR index GREATER example_fence_count)
        message(FATAL_ERROR "Invalid ${example_document} fence index: ${index}")
    endif()
    get_property(names GLOBAL PROPERTY example_cases)
    if(NOT name MATCHES "^[a-zA-Z0-9_-]+$" OR name IN_LIST names)
        message(FATAL_ERROR "Invalid or duplicate example name: ${name}")
    endif()
    file(WRITE "${TEST_DIR}/programs/${name}.brf" "${prefix}\n${code}\n${suffix}\n")
    if(NOT index EQUAL 0)
        set_property(GLOBAL APPEND PROPERTY checked_fences "${index}")
    endif()
    set_property(GLOBAL APPEND PROPERTY example_cases "${name}")
endfunction()
function(panic_example index name prefix code message needle)
    set(source "${prefix}\n${code}\n}\n")
    string(FIND "${source}" "${needle}" at)
    if(at LESS 0)
        message(FATAL_ERROR "Missing panic location anchor: ${needle}")
    endif()
    string(SUBSTRING "${source}" 0 ${at} before)
    string(REGEX MATCHALL "\n" lines "${before}")
    list(LENGTH lines line)
    # Count the source line and example()'s empty-prefix leading newline.
    math(EXPR line "${line} + 2")
    example(${index} "${name}" "" "${source}"
        "// panic: ${message}\n// panic: ${name}.brf:${line}")
endfunction()

function(doc_examples_finish deferred references expected_cases)
    get_property(checked GLOBAL PROPERTY checked_fences)
    list(REMOVE_DUPLICATES checked)
    foreach(index IN LISTS deferred references)
        if(index LESS 1 OR index GREATER example_fence_count)
            message(FATAL_ERROR "Invalid ${example_document} classification index: ${index}")
        endif()
    endforeach()
    # RANGE 1 0 iterates 1 and 0; a prose-only document has no fences to classify.
    if(example_fence_count GREATER 0)
        foreach(index RANGE 1 ${example_fence_count})
            set(classifications 0)
            foreach(kind IN ITEMS checked deferred references)
                if(index IN_LIST ${kind})
                    math(EXPR classifications "${classifications} + 1")
                endif()
            endforeach()
            if(NOT classifications EQUAL 1)
                message(FATAL_ERROR "${example_document} fence ${index} needs exactly one scope classification")
            endif()
        endforeach()
    endif()
    get_property(cases GLOBAL PROPERTY example_cases)
    list(LENGTH cases case_count)
    if(NOT case_count EQUAL expected_cases)
        message(FATAL_ERROR "${example_document} case count changed (${case_count}); update its acceptance audit")
    endif()
    set(options)
    if(DEBUG)
        list(APPEND options --debug)
    endif()
    execute_process(COMMAND "${RUNNER}" --brief "${BRIEF}" --cc "${CC}"
        --programs "${TEST_DIR}/programs" ${options}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${example_document} acceptance failed (${status}):\n${output}\n${errors}")
    endif()
    list(LENGTH checked checked_count)
    list(LENGTH deferred deferred_count)
    list(LENGTH references reference_count)
    message(STATUS "${example_document}: ${checked_count}/${example_fence_count} fences checked in ${case_count} cases; ${deferred_count} deferred, ${reference_count} syntax references\n${output}")
endfunction()
