String { auto: str

  new(auto: str) -> String { String { auto = auto } }
  get(value: String) { value.auto }
}
A_b { value: int
  c(value: A_b) { value.value } }
A { value: int
  b_c(value: A) { value.value } }
method_3_A_b_c() { "top" }
main() {
  let value = String.new("heap" + " string")
  print(value.get()) // expect: heap string
  print(str(A_b { value = 1 }.c())) // expect: 1
  print(str(A { value = 2 }.b_c())) // expect: 2
  print(method_3_A_b_c()) // expect: top
}
