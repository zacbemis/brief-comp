A { n: int }
mut(a: &A) {}
read(a: A) {
  a |> { x => x.n++ } // error: Cannot mutate through an ordinary parameter; use &.
}
value(a: A) {
  let x = a |> { x => x }
  x.n++ // error: Cannot mutate through an ordinary parameter; use &.
}
join(a: A, flag: bool) {
  var x = A { n: 0 }
  flag |> { true => x = a
    false => () }
  x.n++ // error: Cannot mutate through an ordinary parameter; use &.
}
borrow(a: A) {
  a |> mut() // error: A read-only value cannot be passed to an & parameter; take the parameter it comes from as &.
}
backedge(a: A, flag: bool) {
  var x = A { n: 0 }
  while flag {
    mut(x) // error: A read-only value cannot be passed to an & parameter; take the parameter it comes from as &.
    flag |> { true => { x = a
      continue }
      false => break }
  }
}
main() {}
