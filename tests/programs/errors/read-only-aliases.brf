P { name: str }
Q { p: P }
mutate(p: &P) { p.name = "changed" }
sneaky(q: Q) {
  let inner = q.p
  inner.name = "changed" // error: Cannot mutate through an ordinary parameter; use &.
  mutate(inner) // error: A mutable argument cannot be borrowed through an ordinary parameter.
}
rebind(q: Q) {
  var inner = P { name: "fresh" }
  inner = q.p
  inner.name += "!" // error: Cannot mutate through an ordinary parameter; use &.
}
branch(q: Q, flag: bool) {
  let inner = if flag { q.p } else { P { name: "fresh" } }
  mutate(inner) // error: A mutable argument cannot be borrowed through an ordinary parameter.
}
branchAssignment(q: Q, flag: bool) {
  var inner = P { name: "fresh" }
  if flag { inner = q.p }
  mutate(inner) // error: A mutable argument cannot be borrowed through an ordinary parameter.
}
backedge(q: Q, flag: bool) {
  var inner = P { name: "fresh" }
  while flag {
    mutate(inner) // error: A mutable argument cannot be borrowed through an ordinary parameter.
    inner = q.p
    continue
  }
}
loopExit(q: Q) {
  var inner = P { name: "fresh" }
  while true { inner = q.p
    break }
  mutate(inner) // error: A mutable argument cannot be borrowed through an ordinary parameter.
}
same(p: P): P { p }
viaCall(q: Q) {
  let inner = same(q.p)
  inner.name = "changed through an identity call" // error: Cannot mutate through an ordinary parameter; use &.
  mutate(inner) // error: A mutable argument cannot be borrowed through an ordinary parameter.
}
viaLiteral(q: Q) {
  let wrapper = Q { p: q.p }
  wrapper.p.name = "changed through a new struct literal" // error: Cannot mutate through an ordinary parameter; use &.
  mutate(wrapper.p) // error: A mutable argument cannot be borrowed through an ordinary parameter.
}
Report { name: str }
impl Report { new(p: P): Self { Self { name: p.name } } }
freshReport(q: Q) {
  let report = Report.new(q.p)
  report.name = "fresh but conservatively read-only" // error: Cannot mutate through an ordinary parameter; use &.
}
Wrapper { p: P
  name: str }
wholeLiteral(q: Q) {
  let wrapper = Wrapper { p: q.p, name: "fresh" }
  wrapper.name = "even independent fields are read-only" // error: Cannot mutate through an ordinary parameter; use &.
}
main() {}
