Result = :ok[int] | :!bad
f() -> Result { 1 }
take(r: Result) {}
unhandled() {
  f() // error: A call that can fail must be handled with ?, !, or a match.
  let x = f() // N3: this outcome is pending until handled.
  take(f()) // error: A call that can fail must be handled with ?, !, or a match.
  :outer[f()] // error: A call that can fail must be handled with ?, !, or a match.
  ret f() // error: Outcome binding is not handled before leaving its scope.
}
TextResult = :ok[str] | :!bad
readName() -> TextResult { "owned" + " name" }
consumeName(name: str, age: int) {}
getters() {
  let name = readName()
  consumeName(name, 20) // error: Outcome binding must be handled with ?, !, a match, or return.
  let other = readName()
  consumeName(other, // error: Outcome binding must be handled with ?, !, a match, or return.
              "wrong") // error: Function argument has the wrong type.
}
P { number: int
  read() -> int { self.number } }
readObject() -> :ok[P] | :!bad { P { number = 1 } }
projection() {
  let value = readObject()
  value.number // error: Outcome binding must be handled with ?, !, a match, or return.
  value.read()
}
recursiveConversion() {
  if true { ret :!bad }
  int(recursiveForward())? // error: A call that can fail must be handled with ?, !, or a match.
}
recursiveForward() { recursiveConversion()? }
