// expect: 1500
// expect: ok!
// expect: bad
// expect: before
// expect: ok
// expect: 3
Node { text: str }
Pair { first: Node
  second: Node }
Holder { value: Sym<:ok(str), :bad(str)> }
fault(n: int): Sym<:ok(str), :bad(str)> {
  if n % 2 == 0 { ret :bad("b" + "ad") }
  "o" + "k"
}
work(n: int) {
  let scratch = Node { text: "scratch" + str(n) }
  Pair {
    first: scratch
    second: Node { text: fault(n)? + "!" }
  }.second
}
partial(n: int): Sym<:ok(Node), _> { work(n)? }
replace(h: &Holder) { h.value = :bad("after") }
first(a: Sym<:ok(str), :bad(str)>, b: ()) { a |> {
  :ok(s) => s
  :bad(s) => s
} }
ready(n: int): Sym<:ok(bool), :bad(str)> { n < 3 }
start(): Sym<:ok(int), :bad(str)> { 0 }
replaceOrFail(h: &Holder, failed: bool): Sym<:ok, :bad(str)> {
  h.value = :bad("mutated" + " holder")
  if failed { ret :bad("later" + " failure") }
  ()
}
observeFirst(a: Sym<:ok(str), :bad(str)>, ignored: ()) {
  print("callee")
  first(a, ())
}
argumentWork(failed: bool) {
  let h = Holder { value: :ok("argument" + " snapshot") }
  h.value |> observeFirst(replaceOrFail(h, failed)?)
}
ownedCondition(n: int, failAt: int): Sym<:ok(bool), :bad(str)> {
  let scratch = Node { text: "condition" + str(n) }
  if n == failAt { ret :bad(scratch.text + ":stop") }
  n < 3
}
conditionWork(failAt: int) {
  let guard = Node { text: "guard" + " owner" }
  var n = 0
  while ownedCondition(n, failAt)? {
    let body = Node { text: "body" + str(n) }
    n++
    if n == 1 { continue }
  }
  guard.text
}
main() {
  var total = 0
  for i in 0..1000 {
    partial(i) |> {
      :ok(node) => { total += 1
        if i % 4 == 1 { continue }
        let copy = :ok(node) }
      :bad(message) => { total += 2
        let copy = :ok(message) }
    }
  }
  print(str(total))
  print(work(1)!.text)
  work(0) |> { :ok(_) => ()
    other => other |> { :bad(message) => print(message) } }
  let h = Holder { value: :ok("be" + "fore") }
  h.value |> first(replace(h)) |> print()
  // Propagation from an initializer must release the unfinished scope too.
  let node = Node { text: fault(1)? }
  print(node.text)
  var n = start()?
  while ready(n)? { n++ }
  print(str(n))
  argumentWork(false) |> { :ok(text) => print(text)
    :bad(text) => print(text) }
  // expect: callee
  // expect: argument snapshot
  argumentWork(true) |> { :ok(text) => print(text)
    :bad(text) => print(text) }
  // expect: later failure
  conditionWork(-1) |> { :ok(text) => print(text)
    :bad(text) => print(text) }
  // expect: guard owner
  conditionWork(2) |> { :ok(text) => print(text)
    :bad(text) => print(text) }
  // expect: condition2:stop
}
