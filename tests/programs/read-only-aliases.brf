P { name: str }
Q { p: P }
make(name: str): P { P { name: name } }
same(p: P): P { p }
text(p: P): str { p.name }
read(q: Q, flag: bool) {
  let inner = q.p
  print(inner.name)
  var replaced = inner
  replaced = P { name: "fresh" }
  replaced.name += "!"
  print(replaced.name)
  if flag { replaced = make("left") } else { replaced = make("right") }
  replaced.name += "!"
  print(replaced.name)
  while true { replaced = P { name: "loop" }
    break }
  replaced.name += "!"
  print(replaced.name)
  let owned = make(inner.name)
  owned.name += " copy"
  print(owned.name)
  var copied = 1
  copied++
  print(str(copied))
  let called = same(make(inner.name))
  called.name += " call"
  print(called.name)
  let wrapper = Q { p: P { name: text(q.p) } }
  wrapper.p.name += " literal"
  print(wrapper.p.name)
}
change(q: &Q) {
  let inner = same(q.p)
  let wrapper = Q { p: inner }
  wrapper.p.name = "allowed through &"
}
main() {
  let q = Q { p: P { name: "original" } }
  read(q, true)
  // expect: original
  // expect: fresh!
  // expect: left!
  // expect: loop!
  // expect: original copy
  // expect: 2
  // expect: original call
  // expect: original literal
  print(q.p.name) // expect: original
  change(q)
  print(q.p.name) // expect: allowed through &
}
