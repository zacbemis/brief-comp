Self { value: int

  new(n: int) -> Self { Self { value = n } }
  read() -> int { self.value }
}
Holder { value: Self

  wrap(s: Self) -> Holder { Holder { value = s } }
  read() -> Self { self.value }
}
main() {
  let s: Self = Self.new(42)
  print(str(s.read())) // expect: 42
  print(str(Holder.wrap(s).read().read())) // expect: 42
}
