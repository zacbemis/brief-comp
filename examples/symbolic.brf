// Symbolic algebra in one variable x: expressions as a recursive symbol type,
// printing with minimal parentheses, simplification, differentiation,
// evaluation that reports division by zero, and Newton's method built on the
// derivative.

Expr = :num[dbl] | :x | :add[Pair] | :sub[Pair] | :mul[Pair] |
  :div[Pair] | :pow[Power] | :neg[Unary]

// Recursive symbol types reach themselves through a struct.
Pair {
  left: Expr
  right: Expr
}
Power {
  base: Expr
  exponent: int
}
Unary { value: Expr }

num(v: dbl) -> Expr { :num[v] }
x() -> Expr { :x }
add(a: Expr, b: Expr) -> Expr { :add[Pair { left = a, right = b }] }
sub(a: Expr, b: Expr) -> Expr { :sub[Pair { left = a, right = b }] }
mul(a: Expr, b: Expr) -> Expr { :mul[Pair { left = a, right = b }] }
div(a: Expr, b: Expr) -> Expr { :div[Pair { left = a, right = b }] }
pow(a: Expr, n: int) -> Expr { :pow[Power { base = a, exponent = n }] }
neg(a: Expr) -> Expr { :neg[Unary { value = a }] }

// ---- Printing -----------------------------------------------------------

precedence(e: Expr) -> int {
  e |> {
    :add[_] => 1
    :sub[_] => 1
    :mul[_] => 2
    :div[_] => 2
    :neg[_] => 3
    :pow[_] => 4
    :num[v] => if v < 0 { 3 } else { 5 }
    :x => 5
  }
}

// Shows `e` as an operand that needs at least `minimum` precedence.
operand(e: Expr, minimum: int) -> str {
  if precedence(e) < minimum { "(" + show(e) + ")" } else { show(e) }
}

show(e: Expr) -> str {
  e |> {
    :num[v] => str(v)
    :x => "x"
    :add[p] => operand(p.left, 1) + " + " + operand(p.right, 1)
    :sub[p] => operand(p.left, 1) + " - " + operand(p.right, 2)
    :mul[p] => operand(p.left, 2) + " * " + operand(p.right, 2)
    :div[p] => operand(p.left, 2) + " / " + operand(p.right, 3)
    :neg[u] => "-" + operand(u.value, 3)
    :pow[p] => operand(p.base, 5) + "^" + str(p.exponent)
  }
}

// ---- Simplification -----------------------------------------------------

constant(e: Expr) -> :ok[dbl] | :none {
  e |> {
    :num[v] => v
    _ => :none
  }
}

isConstant(e: Expr, value: dbl) -> bool {
  constant(e) |> {
    :ok[v] => v == value
    :none => false
  }
}

simplifyAdd(a: Expr, b: Expr) -> Expr {
  if isConstant(a, 0) { ret b }
  if isConstant(b, 0) { ret a }
  constant(a) |> {
    :ok[x] => constant(b) |> {
      :ok[y] => ret num(x + y)
      :none => ()
    }
    :none => ()
  }
  add(a, b)
}

simplifySub(a: Expr, b: Expr) -> Expr {
  if isConstant(b, 0) { ret a }
  if isConstant(a, 0) { ret simplifyNeg(b) }
  constant(a) |> {
    :ok[x] => constant(b) |> {
      :ok[y] => ret num(x - y)
      :none => ()
    }
    :none => ()
  }
  sub(a, b)
}

simplifyMul(a: Expr, b: Expr) -> Expr {
  if isConstant(a, 0) or isConstant(b, 0) { ret num(0) }
  if isConstant(a, 1) { ret b }
  if isConstant(b, 1) { ret a }
  if isConstant(a, -1) { ret simplifyNeg(b) }
  constant(a) |> {
    :ok[x] => constant(b) |> {
      :ok[y] => ret num(x * y)
      :none => ()
    }
    :none => ()
  }
  // Keep constants on the left: x * 3 becomes 3 * x.
  constant(b) |> {
    :ok[_] => ret simplifyMul(b, a)
    :none => ()
  }
  // Fold a constant into a product that starts with one: 3 * (2 * x) = 6 * x.
  constant(a) |> {
    :ok[x] => b |> {
      :mul[p] => constant(p.left) |> {
        :ok[y] => ret simplifyMul(num(x * y), p.right)
        :none => ()
      }
      _ => ()
    }
    :none => ()
  }
  mul(a, b)
}

simplifyDiv(a: Expr, b: Expr) -> Expr {
  if isConstant(b, 1) { ret a }
  constant(a) |> {
    :ok[x] => constant(b) |> {
      :ok[y] => if y != 0 { ret num(x / y) }
      :none => ()
    }
    :none => ()
  }
  div(a, b)
}

simplifyPow(a: Expr, n: int) -> Expr {
  if n == 0 { ret num(1) }
  if n == 1 { ret a }
  constant(a) |> {
    :ok[v] => if v != 0 or n > 0 { ret num(v ** dbl(n)) }
    :none => ()
  }
  // (b^m)^n = b^(m*n)
  a |> {
    :pow[p] => simplifyPow(p.base, p.exponent * n)
    other => pow(other, n)
  }
}

simplifyNeg(a: Expr) -> Expr {
  a |> {
    :num[v] => num(-v)
    :neg[u] => u.value
    other => neg(other)
  }
}

simplify(e: Expr) -> Expr {
  e |> {
    :add[p] => simplifyAdd(simplify(p.left), simplify(p.right))
    :sub[p] => simplifySub(simplify(p.left), simplify(p.right))
    :mul[p] => simplifyMul(simplify(p.left), simplify(p.right))
    :div[p] => simplifyDiv(simplify(p.left), simplify(p.right))
    :pow[p] => simplifyPow(simplify(p.base), p.exponent)
    :neg[u] => simplifyNeg(simplify(u.value))
    other => other
  }
}

// ---- Calculus -----------------------------------------------------------

derive(e: Expr) -> Expr {
  e |> {
    :num[_] => num(0)
    :x => num(1)
    :add[p] => add(derive(p.left), derive(p.right))
    :sub[p] => sub(derive(p.left), derive(p.right))
    // Product rule: (fg)' = f'g + fg'
    :mul[p] => add(mul(derive(p.left), p.right), mul(p.left, derive(p.right)))
    // Quotient rule: (f/g)' = (f'g - fg') / g^2
    :div[p] => div(sub(mul(derive(p.left), p.right), mul(p.left, derive(p.right))),
      pow(p.right, 2))
    // Power and chain rules: (f^n)' = n * f^(n-1) * f'
    :pow[p] => mul(mul(num(dbl(p.exponent)), pow(p.base, p.exponent - 1)),
      derive(p.base))
    :neg[u] => neg(derive(u.value))
  }
}

eval(e: Expr, at: dbl) -> :ok[dbl] | :!divideByZero {
  e |> {
    :num[v] => v
    :x => at
    :add[p] => eval(p.left, at)? + eval(p.right, at)?
    :sub[p] => eval(p.left, at)? - eval(p.right, at)?
    :mul[p] => eval(p.left, at)? * eval(p.right, at)?
    :div[p] => {
      let divisor = eval(p.right, at)?
      if divisor == 0 { ret :!divideByZero }
      eval(p.left, at)? / divisor
    }
    :pow[p] => {
      let base = eval(p.base, at)?
      if base == 0 and p.exponent < 0 { ret :!divideByZero }
      base ** dbl(p.exponent)
    }
    :neg[u] => -eval(u.value, at)?
  }
}

absolute(v: dbl) -> dbl { if v < 0 { -v } else { v } }

newton(f: Expr, guess: dbl) ->
  :ok[dbl] | :!divideByZero | :!flatSlope[dbl] | :!noConvergence {
  let slope = simplify(derive(f))
  var at = guess
  for i in 0..60 {
    let height = eval(f, at)?
    let tilt = eval(slope, at)?
    if tilt == 0 { ret :!flatSlope[at] }
    let next = at - height / tilt
    if absolute(next - at) < 0.000000000001 { ret next }
    at = next
  }
  :!noConvergence
}

// ---- Demonstration ------------------------------------------------------

study(name: str, f: Expr) {
  print("== " + name)
  print("f(x)   = " + show(f))
  let simple = simplify(f)
  print("simple = " + show(simple))
  let first = simplify(derive(simple))
  print("f'(x)  = " + show(first))
  print("f''(x) = " + show(simplify(derive(first))))
  for i in -1..3 {
    let at = dbl(i)
    eval(simple, at) |> {
      // Adding zero turns IEEE negative zero into zero for display.
      :ok[v] => print("  f(" + str(at) + ") = " + str(v + 0))
      :!divideByZero => print("  f(" + str(at) + ") divides by zero")
    }
  }
}

solve(name: str, f: Expr, guess: dbl) {
  newton(f, guess) |> {
    :ok[root] => print(name + " from " + str(guess) + ": x = " + str(root))
    :!divideByZero => print(name + " from " + str(guess) + ": division by zero")
    :!flatSlope[at] => print(name + " from " + str(guess) +
      ": the slope is flat at x = " + str(at))
    :!noConvergence => print(name + " from " + str(guess) + ": no convergence")
  }
}

main() {
  // 3x^2 + 2x - 5
  let quadratic = sub(add(mul(num(3), pow(x(), 2)), mul(x(), num(2))), num(5))
  study("A quadratic", quadratic)

  // (x + 1) * (x - 1)^3 * 1 + 0
  let product = add(mul(mul(add(x(), num(1)), pow(sub(x(), num(1)), 3)), num(1)), num(0))
  study("A product", product)

  // x / (x - 2)
  let quotient = div(x(), sub(x(), num(2)))
  study("A quotient with a pole at 2", quotient)

  print("")
  print("== Newton's method")
  solve("3x^2 + 2x - 5 = 0", quadratic, 0)
  solve("3x^2 + 2x - 5 = 0", quadratic, -3)
  let two = sub(pow(x(), 2), num(2))
  solve("x^2 - 2 = 0", two, 1)
  solve("x^2 + 1 = 0", add(pow(x(), 2), num(1)), 0)
  solve("1 / x = 0", div(num(1), x()), 0)
  solve("x^3 - 2x + 2 = 0", add(sub(pow(x(), 3), mul(num(2), x())), num(2)), 0)
}
