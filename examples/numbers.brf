// Number theory toolkit: primes and factorizations, gcd and Euler's totient,
// exact fractions with Egyptian-fraction expansion, overflow-safe factorials,
// Roman numerals, base conversion, perfect numbers and the longest Collatz
// chain below a bound.

isPrime(n: lng): bool {
  if n < 2 { ret false }
  if n < 4 { ret true }
  if n % 2 == 0 or n % 3 == 0 { ret false }
  // Every prime above 3 is 6k - 1 or 6k + 1.
  var d: lng = 5
  while d * d <= n {
    if n % d == 0 or n % (d + 2) == 0 { ret false }
    d += 6
  }
  true
}

nextPrime(n: lng): lng {
  var candidate = n + 1
  while not isPrime(candidate) { candidate++ }
  candidate
}

// "360 = 2^3 * 3^2 * 5"
factorize(n: lng): str {
  if n < 2 { ret str(n) + " has no prime factors" }
  var text = str(n) + " ="
  var rest = n
  var factor: lng = 2
  var first = true
  while factor * factor <= rest or rest > 1 {
    if factor * factor > rest { factor = rest }
    var power = 0
    while rest % factor == 0 {
      rest = rest / factor
      power++
    }
    if power > 0 {
      text += (if first { " " } else { " * " }) + str(factor)
      if power > 1 { text += "^" + str(power) }
      first = false
    }
    factor += if factor == 2 { 1 } else { 2 }
  }
  text
}

gcd(a: lng, b: lng): lng {
  var x = if a < 0 { -a } else { a }
  var y = if b < 0 { -b } else { b }
  while y != 0 {
    let r = x % y
    x = y
    y = r
  }
  x
}

// Euler's totient: how many of 1..n share no factor with n.
totient(n: lng): lng {
  var result = n
  var rest = n
  var p: lng = 2
  while p * p <= rest {
    if rest % p == 0 {
      while rest % p == 0 { rest = rest / p }
      result -= result / p
    }
    p++
  }
  if rest > 1 { result -= result / rest }
  result
}

Fraction {
  top: lng
  bottom: lng
}

impl Fraction {
  // Always stored in lowest terms with a positive denominator.
  new(top: lng, bottom: lng): Sym<:ok(Self), :zeroDenominator> {
    if bottom == 0 { ret :zeroDenominator }
    let sign: lng = if bottom < 0 { -1 } else { 1 }
    let g = gcd(top, bottom)
    let common = if g == 0 { 1 } else { g }
    Self { top: sign * top / common, bottom: sign * bottom / common }
  }

  plus(a: Self, b: Self): Self {
    Self.new(a.top * b.bottom + b.top * a.bottom, a.bottom * b.bottom)!
  }

  times(a: Self, b: Self): Self { Self.new(a.top * b.top, a.bottom * b.bottom)! }

  over(a: Self, b: Self): Sym<:ok(Self), :zeroDenominator> {
    Self.new(a.top * b.bottom, a.bottom * b.top)?
  }

  label(f: Self): str {
    if f.bottom == 1 { str(f.top) } else { str(f.top) + "/" + str(f.bottom) }
  }

  // Greedy expansion into distinct unit fractions, e.g. 4/13 = 1/4 + 1/18 + 1/468.
  // Denominators can grow very fast; arithmetic overflow would panic, so the
  // expansion stops with what it has found before a step would overflow.
  egyptian(f: Self): Sym<:ok(str), :tooLarge(str)> {
    var top = f.top
    var bottom = f.bottom
    var text = ""
    while top > 0 {
      let unit = (bottom + top - 1) / top // ceiling of bottom / top
      if unit > 9223372036854775807 / bottom or unit > 9223372036854775807 / top {
        ret :tooLarge(text)
      }
      text += (if text == "" { "" } else { " + " }) + "1/" + str(unit)
      top = top * unit - bottom
      bottom = bottom * unit
      let g = gcd(top, bottom)
      if g > 1 {
        top = top / g
        bottom = bottom / g
      }
    }
    text
  }
}

// n! without overflow: stops with :overflow before the multiplication that
// would exceed lng, instead of panicking.
factorial(n: lng): Sym<:ok(lng), :overflow(lng)> {
  var result: lng = 1
  for k in 2..n + 1 {
    if result > 9223372036854775807 / k { ret :overflow(k) }
    result = result * k
  }
  result
}

roman(n: int): Sym<:ok(str), :outOfRange(int)> {
  if n < 1 or n > 3999 { ret :outOfRange(n) }
  var rest = n
  var text = ""
  for i in 0..13 {
    let value = i |> {
      0 => 1000
      1 => 900
      2 => 500
      3 => 400
      4 => 100
      5 => 90
      6 => 50
      7 => 40
      8 => 10
      9 => 9
      10 => 5
      11 => 4
      _ => 1
    }
    let symbol = i |> {
      0 => "M"
      1 => "CM"
      2 => "D"
      3 => "CD"
      4 => "C"
      5 => "XC"
      6 => "L"
      7 => "XL"
      8 => "X"
      9 => "IX"
      10 => "V"
      11 => "IV"
      _ => "I"
    }
    while rest >= value {
      text += symbol
      rest -= value
    }
  }
  text
}

digit(d: ulng): str {
  d |> {
    0..10 => str(d)
    10 => "a"
    11 => "b"
    12 => "c"
    13 => "d"
    14 => "e"
    _ => "f"
  }
}

inBase(n: ulng, base: ulng): Sym<:ok(str), :badBase(ulng)> {
  if base < 2 or base > 16 { ret :badBase(base) }
  if n == 0 { ret "0" }
  var rest = n
  var text = ""
  while rest > 0 {
    text = digit(rest % base) + text
    rest = rest / base
  }
  text
}

isPerfect(n: lng): bool {
  var sum: lng = 1
  var d: lng = 2
  while d * d <= n {
    if n % d == 0 {
      sum += d
      if d * d != n { sum += n / d }
    }
    d++
  }
  n > 1 and sum == n
}

collatzSteps(start: lng): int {
  var n = start
  var steps = 0
  while n != 1 {
    n = if n % 2 == 0 { n / 2 } else { 3 * n + 1 }
    steps++
  }
  steps
}

expand(f: Fraction) {
  f.egyptian() |> {
    :ok(text) => print(f.label() + " = " + text)
    :tooLarge(partial) => print(f.label() + " = " + partial +
      " + ... (the next step overflows lng)")
  }
}

main() {
  print("== Primes")
  var line = "first primes:"
  var p: lng = 1
  for i in 0..15 {
    p = nextPrime(p)
    line += " " + str(p)
  }
  print(line)
  print("is 2147483647 prime? " + str(isPrime(2147483647)))
  print("is 1000000007 * 3 prime? " + str(isPrime(3000000021)))
  print(factorize(360))
  print(factorize(9699690))
  print(factorize(600851475143))
  print(factorize(1048576))

  print("")
  print("== Divisors")
  print("gcd(1071, 462) = " + str(gcd(1071, 462)))
  print("lcm(21, 6) = " + str(21 / gcd(21, 6) * 6))
  print("totient(36) = " + str(totient(36)) + ", totient(97) = " + str(totient(97)))
  var perfect = "perfect numbers below 10000:"
  // A converted literal bound gives the loop variable its type.
  for n in lng(2)..10000 { if isPerfect(n) { perfect += " " + str(n) } }
  print(perfect)

  print("")
  print("== Fractions")
  let half = Fraction.new(1, 2)!
  let third = Fraction.new(1, 3)!
  let sixth = Fraction.new(-2, -12)!
  print("1/2 + 1/3 + 1/6 = " + half.plus(third).plus(sixth).label())
  print("1/2 * 1/3 = " + half.times(third).label())
  half.over(Fraction.new(0, 5)!) |> {
    :ok(f) => print("1/2 / 0 = " + f.label())
    :zeroDenominator => print("1/2 / 0 has a zero denominator")
  }
  expand(Fraction.new(4, 13)!)
  expand(Fraction.new(7, 15)!)
  expand(Fraction.new(5, 121)!)

  print("")
  print("== Factorials")
  for n in 19..22 {
    factorial(lng(n)) |> {
      :ok(value) => print(str(n) + "! = " + str(value))
      :overflow(k) => print(str(n) + "! overflows lng when multiplying by " + str(k))
    }
  }

  print("")
  print("== Roman numerals and bases")
  for n in 0..5 {
    let value = n |> {
      0 => 1994
      1 => 2026
      2 => 3999
      3 => 4000
      _ => 49
    }
    roman(value) |> {
      :ok(text) => print(str(value) + " = " + text)
      :outOfRange(v) => print(str(v) + " cannot be written in Roman numerals")
    }
  }
  print("255 in base 2 = " + inBase(255, 2)!)
  print("3735928559 in base 16 = " + inBase(3735928559, 16)!)
  print("18446744073709551615 in base 7 = " + inBase(18446744073709551615, 7)!)
  inBase(10, 20) |> {
    :ok(text) => print(text)
    :badBase(b) => print("base " + str(b) + " is not supported")
  }

  print("")
  print("== Collatz")
  var best: lng = 1
  var longest = 0
  for n in lng(1)..300000 {
    let steps = collatzSteps(n)
    if steps > longest {
      longest = steps
      best = n
    }
  }
  print("below 300000, " + str(best) + " takes the most steps to reach 1: " +
    str(longest))
}
